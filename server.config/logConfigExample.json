{
"log": {
        "enabled": true,
        "fromApp": "%OPENPIM_INSTANCE_NAME%",
        "maxMessageSize": 10000,
        "truncateArrays": false,
        "output": {
            "type": "file",
            "path": "/server/request.log",
            "maxSize": 10485760,
            "maxFiles": 5
        }
    },
"log": {
        "enabled": true,
        "fromApp": "PIM",
        "maxMessageSize": 10000,
        "truncateArrays": true,
        "truncateArraysRows": 3,
        "output": {
            "type": "console.out"
        }
    },
"log": {
        "enabled": true,
        "fromApp": "PIM",
        "maxMessageSize": 10000,
        "truncateArrays": true,
        "truncateArraysRows": 3,
        "output": {
            "type": "console.error"
        }
    },
"log": {
    "enabled": true,
    "fromApp": "PIM",
    "maxMessageSize": 10000,
    "output": {
      "type": "elasticsearch",
      "node": "url",
      "index": "pim-logs",
      "auth": {
        "username": "username",
        "password": "password"
      }
    }
  }
}
